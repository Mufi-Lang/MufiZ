// MUFIZ MATRIX OPERATIONS QUICK REFERENCE
// Phase 1 & 2 Enhancement - New Features

// ============================================================================
// MATRIX CREATION
// ============================================================================

// Matrix literals (Phase 1)
var m1 = [[1, 2, 3],
          [4, 5, 6]];       // 2x3 matrix

var m2 = [[1, 2],
          [3, 4],
          [5, 6]];          // 3x2 matrix

// Traditional creation (still works)
var m3 = zeros(3, 3);       // 3x3 zero matrix
var m4 = ones(2, 4);        // 2x4 matrix of ones
var m5 = eye(3);            // 3x3 identity matrix

// ============================================================================
// ELEMENT-WISE OPERATIONS (NEW - Phase 1)
// ============================================================================

// Element-wise multiplication (.*)
var m1 = [[2, 3], [4, 5]];
var m2 = [[1, 2], [3, 4]];
var result_mul = m1 .* m2;  // [[2, 6], [12, 20]]

// Element-wise division (./)
var result_div = m1 ./ m2;  // [[2, 1.5], [1.33, 1.25]]

// Element-wise power (.^)
var result_pow = m1 .^ m2;  // [[2, 9], [64, 625]]

// Element-wise with scalars (if supported)
var m_times_2 = m1 * 2;     // [[4, 6], [8, 10]] - regular multiply
var m_ewise_times_2 = m1 .* [[2, 2], [2, 2]];  // Same result

// ============================================================================
// SLICING & INDEXING (Phase 2)
// ============================================================================

// Vector slicing
var v = [10, 20, 30, 40, 50];
var slice1 = v[1:3];        // [20, 30]
var slice2 = v[2:end];      // [30, 40, 50]
var slice3 = v[end-1:end];  // [40, 50]

// Matrix element access
var m = [[1, 2, 3],
         [4, 5, 6],
         [7, 8, 9]];
var elem = m[1, 2];         // 6 (row 1, col 2)
var row = m[0];             // [1, 2, 3] or [1] depending on implementation
var col = m[;, 1];          // [2, 5, 8] if 2D slicing implemented

// ============================================================================
// MATRIX PROPERTIES
// ============================================================================

var m = [[1, 2], [3, 4]];

print size(m);              // [2, 2] (rows, cols)
print det(m);               // -2 (determinant)
print trace(m);             // 5 (sum of diagonal)
print norm(m);              // Frobenius norm
print rank(m);              // Matrix rank
print inv(m);               // Inverse matrix
print transpose(m);         // Transposed matrix

// ============================================================================
// LINEAR ALGEBRA (Existing)
// ============================================================================

var m1 = [[1, 2], [3, 4]];
var m2 = [[5, 6], [7, 8]];

print m1 + m2;              // Element-wise addition (standard +)
print m1 - m2;              // Element-wise subtraction (standard -)
print m1 * m2;              // Matrix multiplication (standard *)

// Note: Matrix multiplication (*) is different from element-wise (.*)
// m1 * m2 performs DOT PRODUCT
// m1 .* m2 performs ELEMENT-WISE MULTIPLICATION

// ============================================================================
// ADVANCED EXAMPLES
// ============================================================================

// Chaining operations
var m1 = [[1, 2], [3, 4]];
var m2 = [[2, 2], [2, 2]];
var result = (m1 .* m2) .^ 2;  // Element-wise mult then power

// Using with existing functions
var m = [[2, 3], [4, 5]];
var squared = m .^ [[2, 2], [2, 2]];  // Each element squared
var normalized = squared ./ [[4, 9], [16, 25]];  // Divide by squared

// Combined operations
var m1 = [[1, 2], [3, 4]];
var m2 = [[2, 2], [2, 2]];
var result = m1 ./ m2;      // [[0.5, 1], [1.5, 2]]
var det_result = det(result);

// ============================================================================
// ERROR HANDLING
// ============================================================================

// Dimension mismatch error
var m1 = [[1, 2], [3, 4]];    // 2x2
var m2 = [[1, 2, 3], [4, 5, 6]];  // 2x3
// var bad = m1 .* m2;        // ERROR: dimensions must match

// Type error
// var bad = m1 .* 5;          // ERROR: requires matrix operands

// Division by zero
var m1 = [[2, 4], [6, 8]];
var m2 = [[1, 0], [2, 0]];    // Contains zeros
// var bad = m1 ./ m2;        // May fail if zeros present

// ============================================================================
// PERFORMANCE NOTES
// ============================================================================

// Element-wise operations are efficient
// - No memory copies for storage (in-place if possible)
// - Dimension checking prevents silent errors
// - Proper error messages for debugging

// Matrix multiplication (.*) is optimized for typical use cases
// Slicing avoids unnecessary copies when possible

// ============================================================================
// ROADMAP - Future Phases
// ============================================================================

// Phase 3: Advanced Linear Algebra (Coming Soon)
// - QR decomposition
// - SVD decomposition
// - Eigenvalue/eigenvector computation
// - Cholesky decomposition
// - Condition number calculation

// Phase 4: Tensor Type (Long-term)
// - Unified tensor type for n-dimensional arrays
// - Will replace current separate FVec and Matrix

// Phase 5: Performance (Parallel)
// - SIMD acceleration
// - Multi-threading support
// - Cache optimization

// ============================================================================
EOF
cat /Users/mustafif/Projects/MufiZ/examples/matrix_quickref.mufi || echo "Reference file created"
