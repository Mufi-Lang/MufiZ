print("Starting test");

foreach (i in 1..3) {
    print("Outer: " + i);
    if (i == 1) {
        print("  Conditional for i=1");
        foreach (j in 1..2) {
            print("    Inner: " + j);
        }
    } else if (i == 2) {
        print("  Conditional for i=2");
        foreach (j in 1..3) {
            print("    Inner: " + j);
        }
    }
}

print("Done");
