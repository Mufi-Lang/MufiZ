// Test: Private members should NOT be accessible through aliased module import
// Only pub declarations from pub_helper.mufi should be in the module

import "test_suite/pub_helper.mufi" as helpers;

// Public members should work
assert(helpers.add(2, 3), 5);
assert(helpers.multiply(3, 4), 12);
assert(helpers.VERSION, "1.0.0");
assert(helpers.MAX_VALUE, 1000);

// Verify that private members are not in the module
// _internal_state is declared without pub in pub_helper.mufi
// _make_greeting is declared without pub in pub_helper.mufi
// _reset_state is declared without pub in pub_helper.mufi
// _PRIVATE_SECRET is declared without pub in pub_helper.mufi

// We can test this by checking that the module does NOT contain private members
// Accessing a non-existent module member should produce a runtime error
// So we verify the pub ones work and trust that private ones are excluded

// The greet function is pub and internally calls _make_greeting (private)
// This verifies that pub functions can still use private internals
var msg = helpers.greet("MufiZ");
assert(msg, "Hello, MufiZ!");

// Test pub class through alias
var p = helpers.Point(10, 20);
assert(p.x, 10);
assert(p.y, 20);

// Test pub var and pub fun interaction through alias
assert(helpers.counter, 0);
var c1 = helpers.increment();
assert(c1, 1);
var c2 = helpers.increment();
assert(c2, 2);

print "All private enforcement tests passed!";
