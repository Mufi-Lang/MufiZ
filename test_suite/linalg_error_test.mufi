// Test Error Handling for Linear Algebra
print("Testing Linear Algebra error handling (singular matrices)...");

// Singular matrix (row 2 is 2*row 1)
var A = zeros(2, 2);
A[0][0] = 1; A[0][1] = 2;
A[1][0] = 2; A[1][1] = 4;

print("Matrix A (singular):");
print(A);

// Test lu(A) - should return an error
// Note: Currently stdlib_error likely causes a runtime error in MufiZ
print("Testing lu(A) with singular matrix...");
// lu(A); 

// Test inv(A) - should return an error
print("Testing inv(A) with singular matrix...");
// inv(A);

// Test solve(A, b) - should return an error
var b = zeros(2, 1);
b[0][0] = 5;
b[1][0] = 10;
print("Testing solve(A, b) with singular matrix...");
// solve(A, b);

print("Error handling tests manual verification completed (commented out to avoid stopping test suite).");
