// Test file for new language features
// Testing logical AND/OR operators and ternary expressions

print("=== TESTING NEW LANGUAGE FEATURES ===");

// Test 1: Logical AND operator
print("\n[Test 1] Logical AND operator");
var x = 5;
var y = 10;

if (x > 0 and y > 0) {
    print("✓ Both x and y are positive (using 'and')");
} else {
    print("✗ AND operator failed");
}

// Test short-circuiting with AND
var result1 = false and (x > 100);  // Should short-circuit and be false
print("✓ AND short-circuiting works - result: " + str(result1));

// Test 2: Logical OR operator
print("\n[Test 2] Logical OR operator");
var a = 0;
var b = 15;

if (a > 0 or b > 0) {
    print("✓ At least one value is positive (using 'or')");
} else {
    print("✗ OR operator failed");
}

// Test short-circuiting with OR
var result2 = true or (x > 100);  // Should short-circuit and be true
print("✓ OR short-circuiting works - result: " + str(result2));

// Test 3: Complex logical expressions
print("\n[Test 3] Complex logical expressions");
var age = 25;
var hasLicense = true;
var hasInsurance = true;

if (age >= 18 and hasLicense and hasInsurance) {
    print("✓ Can drive (multiple AND conditions)");
}

var isWeekend = false;
var isHoliday = true;
var isVacation = false;

if (isWeekend or isHoliday or isVacation) {
    print("✓ No work today (multiple OR conditions)");
}

// Test 4: Mixed AND/OR expressions
print("\n[Test 4] Mixed AND/OR expressions");
var temperature = 75;
var humidity = 60;
var isSunny = true;

if ((temperature > 70 and temperature < 80) or (humidity < 70 and isSunny)) {
    print("✓ Nice weather conditions");
}

// Test 5: Ternary operator
print("\n[Test 5] Ternary operator");
var score = 85;
var grade = score >= 90 ? "A" : (score >= 80 ? "B" : (score >= 70 ? "C" : "F"));
print("Score " + str(score) + " gets grade: " + grade);

// Test nested ternary
var num = -5;
var description = num > 0 ? "positive" : (num < 0 ? "negative" : "zero");
print("Number " + str(num) + " is " + description);

// Test 6: Ternary with different data types
print("\n[Test 6] Ternary with different data types");
var count = 3;
var message = count == 1 ? "item" : "items";
print("You have " + str(count) + " " + message);

var isActive = true;
var status = isActive ? 1 : 0;
print("Status code: " + str(status));

// Test 7: Variable scope in loops (should now work)
print("\n[Test 7] Variable scope in loops");

print("Testing while loops with variable reuse:");
var i = 0;
while (i < 3) {
    print("First loop: i = " + str(i));
    i = i + 1;
}

// This should now work without "variable already declared" error
var i = 0;
while (i < 2) {
    print("Second loop: i = " + str(i));
    i = i + 1;
}

print("Testing for loops with variable reuse:");
for (var j = 0; j < 3; j = j + 1) {
    print("First for loop: j = " + str(j));
}

for (var j = 10; j < 12; j = j + 1) {
    print("Second for loop: j = " + str(j));
}

// Test 8: Logical operators with different data types
print("\n[Test 8] Logical operators with different data types");
var str1 = "hello";
var str2 = "";
var num1 = 42;
var num2 = 0;

if (str1 and num1) {
    print("✓ Non-empty string and non-zero number are truthy");
}

if (str2 or num2 or true) {
    print("✓ OR works with mixed falsy and truthy values");
}

// Test 9: Logical operators in expressions
print("\n[Test 9] Logical operators in expressions");
var canVote = age >= 18 and true;
print("Can vote: " + str(canVote));

var needsHelp = false or (age < 16) or (age > 80);
print("Needs help: " + str(needsHelp));

// Test 10: Ternary in complex expressions
print("\n[Test 10] Ternary in complex expressions");
var x1 = 10;
var x2 = 20;
var max = x1 > x2 ? x1 : x2;
print("Maximum of " + str(x1) + " and " + str(x2) + " is: " + str(max));

// Ternary in function calls
var absolute = num < 0 ? -num : num;
print("Absolute value of " + str(num) + " is: " + str(absolute));

// Test 11: Precedence testing
print("\n[Test 11] Operator precedence");
var result = true or false and false;  // Should be true (AND has higher precedence)
print("true or false and false = " + str(result) + " (should be true)");

var result2 = false and true or true;  // Should be true
print("false and true or true = " + str(result2) + " (should be true)");

// Test 12: Error handling and edge cases
print("\n[Test 12] Edge cases");

// Ternary with nil values
var maybeValue = nil;
var defaulted = maybeValue ? maybeValue : "default";
print("Nil ternary result: " + str(defaulted));

// Logical operators with nil
var nilCheck = nil or "not nil";
print("Nil OR result: " + str(nilCheck));

print("\n=== ALL LANGUAGE FEATURE TESTS COMPLETED ===");
