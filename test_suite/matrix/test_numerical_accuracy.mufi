// Simplified numerical accuracy tests for matrix decompositions

print "=== Numerical Accuracy Tests ===\n";

// Test 1: QR decomposition - Q should be orthogonal and QR should reconstruct A
print "--- QR Decomposition Accuracy ---";
var A = [[1, 2, 3], [4, 5, 6], [7, 8, 10]];

var result = qr(A);
var Q = result["Q"];
var R = result["R"];

// Verify Q^T*Q ≈ I (orthogonality)
var Q_T = transpose(Q);
var Q_T_Q = Q_T * Q;
var I_approx = eye(3);

var ortho_error = 0;
var i = 0;
var j = 0;
for (i = 0; i < 3; i = i + 1) {
    for (j = 0; j < 3; j = j + 1) {
        ortho_error = ortho_error + abs(Q_T_Q[i, j] - I_approx[i, j]);
    }
}
// Check that orthogonality error is small
if (ortho_error < 0.1) {
    print "✓ QR: Q is approximately orthogonal";
} else {
    print "✗ QR: Orthogonality error too large: " + to_s(ortho_error);
}

// Verify A ≈ Q*R (reconstruction)
var A_reconstructed = Q * R;
var reconstruction_error = 0;
for (i = 0; i < 3; i = i + 1) {
    for (j = 0; j < 3; j = j + 1) {
        reconstruction_error = reconstruction_error + abs(A[i, j] - A_reconstructed[i, j]);
    }
}

if (reconstruction_error < 0.1) {
    print "✓ QR: Q*R reconstructs A";
} else {
    print "✗ QR: Reconstruction error too large: " + to_s(reconstruction_error);
}

print "\n=== Numerical Accuracy Tests Complete ===";
