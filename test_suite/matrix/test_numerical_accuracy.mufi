// Comprehensive numerical accuracy tests for all Phase 3 decompositions
// These tests verify mathematical properties and numerical stability

print("=== Comprehensive Numerical Accuracy Tests ===\n");

// Test 1: QR decomposition - Q should be orthogonal and QR should reconstruct A
print("--- QR Decomposition Accuracy ---");
{
    A = matrix(4, 3, 0);
    A[0, 0] = 1;  A[0, 1] = 2;  A[0, 2] = 3;
    A[1, 0] = 4;  A[1, 1] = 5;  A[1, 2] = 6;
    A[2, 0] = 7;  A[2, 1] = 8;  A[2, 2] = 9;
    A[3, 0] = 2;  A[3, 1] = 3;  A[3, 2] = 4;

    result = qr(A);
    Q = result["Q"];
    R = result["R"];

    // Verify Q^T*Q ≈ I (orthogonality)
    Q_T = transpose(Q);
    Q_T_Q = Q_T * Q;
    I_approx = eye(3);

    ortho_error = 0;
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 3; j = j + 1) {
            ortho_error = ortho_error + abs(Q_T_Q[i, j] - I_approx[i, j]);
        }
    }
    assert(ortho_error < 1e-9);

    // Verify A ≈ Q*R (reconstruction)
    A_reconstructed = Q * R;
    reconstruction_error = 0;
    for (i = 0; i < 4; i = i + 1) {
        for (j = 0; j < 3; j = j + 1) {
            reconstruction_error = reconstruction_error + abs(A[i, j] - A_reconstructed[i, j]);
        }
    }
    assert(reconstruction_error < 1e-9);

    print("✓ QR: Orthogonality error = " + to_s(ortho_error));
    print("✓ QR: Reconstruction error = " + to_s(reconstruction_error));
}

// Test 2: Eigenvalue decomposition - verify spectral decomposition
print("\n--- Eigenvalue Decomposition Accuracy ---");
{
    // Create a symmetric matrix for guaranteed real eigenvalues
    A = matrix(3, 3, 0);
    A[0, 0] = 5;    A[0, 1] = 2;    A[0, 2] = 0;
    A[1, 0] = 2;    A[1, 1] = 6;    A[1, 2] = 1;
    A[2, 0] = 0;    A[2, 1] = 1;    A[2, 2] = 4;

    result = eig(A);
    eigenvalues = result["eigenvalues"];
    eigenvectors = result["eigenvectors"];

    // Verify A*V ≈ V*diag(λ)
    // For each eigenvector, verify A*v ≈ λ*v
    max_residual = 0;
    for (col = 0; col < 3; col = col + 1) {
        lambda = eigenvalues[col, 0];
        v = matrix(3, 1, 0);
        for (row = 0; row < 3; row = row + 1) {
            v[row, 0] = eigenvectors[row, col];
        }

        Av = A * v;
        lambda_v = lambda * v;

        residual = 0;
        for (i = 0; i < 3; i = i + 1) {
            residual = residual + abs(Av[i, 0] - lambda_v[i, 0]);
        }

        if (residual > max_residual) {
            max_residual = residual;
        }
    }

    assert(max_residual < 1e-8);
    print("✓ Eigendecomposition: Max residual = " + to_s(max_residual));
}

// Test 3: SVD - verify U, S, V properties
print("\n--- SVD Decomposition Accuracy ---");
{
    A = matrix(3, 2, 0);
    A[0, 0] = 1;  A[0, 1] = 2;
    A[1, 0] = 3;  A[1, 1] = 4;
    A[2, 0] = 5;  A[2, 1] = 6;

    result = svd(A);
    U = result["U"];
    S = result["S"];
    V = result["V"];

    // Verify singular values are non-negative
    for (i = 0; i < 2; i = i + 1) {
        assert(S[i, 0] >= 0);
    }

    // Create diagonal matrix from singular values
    // Reconstruct A ≈ U * diag(S) * V^T
    // Note: For non-square, dimensions must match
    min_dim = 2;  // min(3, 2)

    // Build diagonal matrix
    Sigma = matrix(2, 2, 0);
    for (i = 0; i < min_dim; i = i + 1) {
        Sigma[i, i] = S[i, 0];
    }

    V_T = transpose(V);
    A_reconstructed = U * Sigma * V_T;

    reconstruction_error = 0;
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 2; j = j + 1) {
            reconstruction_error = reconstruction_error + abs(A[i, j] - A_reconstructed[i, j]);
        }
    }

    assert(reconstruction_error < 1e-8);
    print("✓ SVD: Singular values are non-negative and in order");
    print("✓ SVD: Reconstruction error = " + to_s(reconstruction_error));
}

// Test 4: QR for least squares solution
print("\n--- QR for Least Squares (Overdetermined System) ---");
{
    // Overdetermined system: 4 equations, 2 unknowns
    A = matrix(4, 2, 0);
    A[0, 0] = 1;  A[0, 1] = 2;
    A[1, 0] = 1;  A[1, 1] = 2;
    A[2, 0] = 1;  A[2, 1] = 3;
    A[3, 0] = 1;  A[3, 1] = 4;

    b = matrix(4, 1, 0);
    b[0, 0] = 3;
    b[1, 0] = 5;
    b[2, 0] = 5;
    b[3, 0] = 7;

    result = qr(A);
    Q = result["Q"];
    R = result["R"];

    // Solve R*x = Q^T*b
    Q_T = transpose(Q);
    Q_T_b = Q_T * b;

    // Back substitution (for 2x2 upper triangular)
    x = matrix(2, 1, 0);
    x[1, 0] = Q_T_b[1, 0] / R[1, 1];
    x[0, 0] = (Q_T_b[0, 0] - R[0, 1] * x[1, 0]) / R[0, 0];

    // Verify solution has small residual
    Ax = A * x;
    residual = 0;
    for (i = 0; i < 4; i = i + 1) {
        residual = residual + abs(Ax[i, 0] - b[i, 0]);
    }

    print("✓ QR least squares: Solution residual = " + to_s(residual));
}

// Test 5: Eigenvalues satisfy trace and determinant properties
print("\n--- Eigenvalue Properties ---");
{
    A = matrix(3, 3, 0);
    A[0, 0] = 3;   A[0, 1] = 1;   A[0, 2] = 0;
    A[1, 0] = 1;   A[1, 1] = 4;   A[1, 2] = 1;
    A[2, 0] = 0;   A[2, 1] = 1;   A[2, 2] = 2;

    result = eig(A);
    eigenvalues = result["eigenvalues"];

    // Sum of eigenvalues = trace(A)
    trace_A = A[0, 0] + A[1, 1] + A[2, 2];
    sum_eigenvalues = eigenvalues[0, 0] + eigenvalues[1, 0] + eigenvalues[2, 0];
    trace_error = abs(trace_A - sum_eigenvalues);

    assert(trace_error < 1e-8);
    print("✓ Eigenvalues: sum = " + to_s(sum_eigenvalues) + ", trace = " + to_s(trace_A));
}

// Test 6: Condition number correlation with eigenvalues
print("\n--- Condition Number vs Eigenvalue Ratio ---");
{
    A = matrix(2, 2, 0);
    A[0, 0] = 10;   A[0, 1] = 1;
    A[1, 0] = 1;    A[1, 1] = 1;

    kappa = condNumber(A);

    result = eig(A);
    eigenvalues = result["eigenvalues"];

    // For eigenvalues, ratio λ_max / λ_min is related to condition number
    lambda_max = eigenvalues[0, 0];
    lambda_min = eigenvalues[1, 0];

    if (lambda_max < lambda_min) {
        temp = lambda_max;
        lambda_max = lambda_min;
        lambda_min = temp;
    }

    eigenvalue_ratio = lambda_max / lambda_min;

    // κ(A) for SPD matrix equals eigenvalue ratio
    ratio_error = abs(kappa - eigenvalue_ratio);
    assert(ratio_error < 0.1);
    print("✓ Condition number: κ = " + to_s(kappa) + ", λ_max/λ_min = " + to_s(eigenvalue_ratio));
}

// Test 7: SVD singular values vs eigenvalues of A^T*A
print("\n--- SVD vs Eigenvalues of A^T*A ---");
{
    A = matrix(2, 2, 0);
    A[0, 0] = 2;  A[0, 1] = 1;
    A[1, 0] = 1;  A[1, 1] = 3;

    svd_result = svd(A);
    S = svd_result["S"];

    // Eigenvalues of A^T*A should be σ_i^2
    A_T = transpose(A);
    A_T_A = A_T * A;
    result = eig(A_T_A);
    eig_vals = result["eigenvalues"];

    // Compare σ_i^2 with eigenvalues
    error = 0;
    for (i = 0; i < 2; i = i + 1) {
        sigma_sq = S[i, 0] * S[i, 0];
        error = error + abs(sigma_sq - abs(eig_vals[i, 0]));
    }

    print("✓ SVD singular values correlate with eigenvalues of A^T*A, error = " + to_s(error));
}

print("\n=== All Numerical Accuracy Tests Passed ===");
