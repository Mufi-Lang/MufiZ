// Test matrix slicing with colon syntax

print "=== Matrix Slicing Tests ===";

// Test 1: Vector slicing (should already work)
var v = [1, 2, 3, 4, 5];
print "Original vector: [1,2,3,4,5]";
var slice1 = v[1:3];
print "v[1:3]:";
print slice1;

// Test 2: Simple matrix slicing
var m = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
print "\nOriginal 3x3 matrix:";
print det(m);  // Just to check it works

// Try slicing a single row
var row = m[0];
print "m[0]:";
print row;

// Try slicing a single element
var elem = m[1, 2];
print "m[1, 2]:";
print elem;

print "\n=== Basic slicing tests completed ===";
