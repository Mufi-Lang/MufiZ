// Test Cholesky decomposition (simplified)
// For symmetric positive definite (SPD) matrices: A = L*L^T

print "=== Cholesky Decomposition Tests ===";

// Test 1: Simple 2x2 SPD matrix
var A = [[4, 2], [2, 3]];
var result = cholesky(A);

if (result != nil) {
    var L = result["L"];
    
    // Verify A = L*L^T
    var L_T = transpose(L);
    var A_reconstructed = L * L_T;
    
    var max_diff = 0;
    var i = 0;
    var j = 0;
    for (i = 0; i < 2; i = i + 1) {
        for (j = 0; j < 2; j = j + 1) {
            var diff = abs(A[i, j] - A_reconstructed[i, j]);
            if (diff > max_diff) {
                max_diff = diff;
            }
        }
    }
    
    if (max_diff < 0.001) {
        print "✓ 2x2 SPD matrix: A = L*L^T verified";
    } else {
        print "✗ Error: Reconstruction error too large: " + to_s(max_diff);
    }
} else {
    print "✗ Cholesky failed for SPD matrix";
}

// Test 2: Identity matrix
var I = eye(3);
var result2 = cholesky(I);

if (result2 != nil) {
    print "✓ Cholesky of identity matrix succeeded";
} else {
    print "✗ Cholesky of identity matrix failed";
}

print "\n=== Cholesky Decomposition Tests Complete ===";
