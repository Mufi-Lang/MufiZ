// Test condition number calculation
// Condition number κ(A) = σ_max / σ_min is a measure of numerical stability
// Low κ (close to 1): well-conditioned, numerically stable
// High κ (>> 1): ill-conditioned, numerically unstable

print("=== Condition Number Tests ===");

// Test 1: Identity matrix - well-conditioned (κ = 1)
{
    A = eye(3);
    kappa = condNumber(A);
    assert(kappa >= 0.99 and kappa <= 1.01);
    print("✓ Identity matrix: κ = " + to_s(kappa));
}

// Test 2: Diagonal matrix with known condition number
{
    D = matrix(3, 3, 0);
    D[0, 0] = 1;
    D[1, 1] = 10;
    D[2, 2] = 100;
    kappa = condNumber(D);
    // κ = 100 / 1 = 100
    assert(kappa >= 99 and kappa <= 101);
    print("✓ Diagonal matrix [1, 10, 100]: κ = " + to_s(kappa));
}

// Test 3: Scaled identity - still well-conditioned
{
    A = eye(3);
    A = A * 5;
    kappa = condNumber(A);
    assert(kappa >= 0.99 and kappa <= 1.01);
    print("✓ Scaled identity (5*I): κ = " + to_s(kappa));
}

// Test 4: Hilbert matrix - famously ill-conditioned
{
    n = 4;
    H = matrix(n, n, 0);
    for (i = 0; i < n; i = i + 1) {
        for (j = 0; j < n; j = j + 1) {
            H[i, j] = 1 / (i + j + 1);
        }
    }
    kappa = condNumber(H);
    // Hilbert matrix 4x4 has κ ≈ 15000+
    assert(kappa > 1000);
    print("✓ Hilbert matrix 4x4: κ = " + to_s(kappa));
}

// Test 5: Near-singular matrix - very ill-conditioned
{
    A = matrix(2, 2, 0);
    A[0, 0] = 1;
    A[0, 1] = 1;
    A[1, 0] = 1;
    A[1, 1] = 1 + 1e-6;
    kappa = condNumber(A);
    // κ should be very large due to near-singularity
    assert(kappa > 1000);
    print("✓ Near-singular matrix: κ = " + to_s(kappa));
}

// Test 6: Random orthogonal-like matrix - good conditioning
{
    A = matrix(3, 3, 0);
    A[0, 0] = 1;    A[0, 1] = 0;    A[0, 2] = 0;
    A[1, 0] = 0;    A[1, 1] = 1;    A[1, 2] = 0;
    A[2, 0] = 0;    A[2, 1] = 0;    A[2, 2] = 1;
    kappa = condNumber(A);
    assert(kappa >= 0.99 and kappa <= 1.01);
    print("✓ Orthogonal matrix: κ = " + to_s(kappa));
}

// Test 7: Condition number consistency
{
    A = matrix(2, 2, 0);
    A[0, 0] = 4;   A[0, 1] = 3;
    A[1, 0] = 6;   A[1, 1] = 3;
    kappa1 = condNumber(A);
    kappa2 = condNumber(A);
    assert(kappa1 == kappa2);
    print("✓ Consistency check: κ = " + to_s(kappa1));
}

// Test 8: Condition number of transpose equals original
{
    A = matrix(3, 3, 0);
    A[0, 0] = 1;
    A[0, 1] = 2;
    A[0, 2] = 3;
    A[1, 0] = 4;
    A[1, 1] = 5;
    A[1, 2] = 6;
    A[2, 0] = 7;
    A[2, 1] = 8;
    A[2, 2] = 10;
    kappa_A = condNumber(A);
    A_T = transpose(A);
    kappa_AT = condNumber(A_T);
    assert(kappa_A >= kappa_AT * 0.99 and kappa_A <= kappa_AT * 1.01);
    print("✓ κ(A) = κ(A^T): " + to_s(kappa_A) + " ≈ " + to_s(kappa_AT));
}

print("\n=== All Condition Number Tests Passed ===");
