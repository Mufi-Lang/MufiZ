// Test condition number calculation (simplified)
// Condition number κ(A) = σ_max / σ_min is a measure of numerical stability

print "=== Condition Number Tests ===";

// Test 1: Identity matrix - well-conditioned (κ = 1)
var I = eye(3);
var kappa = condNumber(I);
print "✓ Identity matrix: κ = " + kappa;

// Test 2: Simple matrix
var A = [[2, 1], [1, 2]];
var kappa_a = condNumber(A);
print "✓ Simple matrix: κ = " + kappa_a;

// Test 3: Scaled identity - still well-conditioned
var I2 = eye(2);
var A_scaled = I2 * 5;
var kappa_scaled = condNumber(A_scaled);
print "✓ Scaled identity (5*I): κ = " + kappa_scaled;

print "\n=== Condition Number Tests Complete ===";
