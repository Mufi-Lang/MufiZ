// Test Suite: Matrix basic operations  
// Simplified test without element-wise operators

print "=== Matrix Operations Tests ===";

print "\n[Test 1] Basic matrix operations";
var m1 = [[2, 3], [4, 5]];
var m2 = [[1, 2], [3, 4]];
var result = m1 * m2;

// Verify dimensions
var dims = size(result);
assert(dims[0, 0] == 2.0);  // rows
assert(dims[0, 1] == 2.0);  // cols

print "✓ Matrix multiplication works";

print "\n[Test 2] Matrix transpose";
var A = [[1, 2, 3], [4, 5, 6]];
var AT = transpose(A);
var dims_t = size(AT);
assert(dims_t[0, 0] == 3.0);  // rows (should be swapped)
assert(dims_t[0, 1] == 2.0);  // cols (should be swapped)
print "✓ Matrix transpose works";

print "\n[Test 3] Matrix trace";
var m = [[1, 2], [3, 4]];
var tr = trace(m);
assert(tr == 5.0);
print "✓ Matrix trace works";

print "\n=== Matrix Operations Tests Complete ===";
