// Test: import "file.mufi" as alias;
// Only pub declarations should be accessible via the alias module

import "test_suite/pub_helper.mufi" as helpers;

// Test pub functions through the alias
var sum = helpers.add(3, 4);
assert(sum, 7);

var product = helpers.multiply(5, 6);
assert(product, 30);

var greeting = helpers.greet("World");
assert(greeting, "Hello, World!");

// Test pub constants through the alias
assert(helpers.VERSION, "1.0.0");
assert(helpers.MAX_VALUE, 1000);

// Test pub var through the alias
assert(helpers.counter, 0);
helpers.increment();
assert(helpers.counter, 1);

// Test pub class through the alias
var p = helpers.Point(3, 4);
assert(p.x, 3);
assert(p.y, 4);

print "All pub import alias tests passed!";
