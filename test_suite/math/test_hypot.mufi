// Test hypot function (Euclidean distance)
print("Testing hypot...");

// 3-4-5 triangle
var h1 = hypot(3.0, 4.0);
assert(h1, 5.0);

// 5-12-13 triangle
var h2 = hypot(5.0, 12.0);
assert(h2, 13.0);

// Equal sides
var h3 = hypot(1.0, 1.0);
var expected = sqrt(2.0);
assert(round(h3 * 1000.0), round(expected * 1000.0));

// Zero cases
var h4 = hypot(0.0, 5.0);
assert(h4, 5.0);

var h5 = hypot(5.0, 0.0);
assert(h5, 5.0);

var h6 = hypot(0.0, 0.0);
assert(h6, 0.0);

print("hypot tests pass");
