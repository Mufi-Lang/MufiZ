import math;
// Phase 4: Enhanced Randomness & Special Functions Tests

// Test set_seed and get_seed
set_seed(42);
var s1 = get_seed();
print("Seed set to 42, retrieved:" + str(s1));

// Test randint
var r1 = randint(1, 10);
var r2 = randint(1, 10);
print("randint(1,10):" + str(r1, r2));

// Test isnan
print("isnan(1.5):" + str(isnan(1.5)));

// Test isinf
print("isinf(1.5):" + str(isinf(1.5)));

// Test isfinite
print("isfinite(1.5):" + str(isfinite(1.5)));

// Test factorial
var fact5 = factorial(5);
print("factorial(5):" + str(fact5));
var fact0 = factorial(0);
print("factorial(0):" + str(fact0));

// Test gcd
var gcd_val = gcd(48, 18);
print("gcd(48, 18):" + str(gcd_val));

// Test lcm
var lcm_val = lcm(12, 18);
print("lcm(12, 18):" + str(lcm_val));

// Test isprime
print("isprime(17):" + str(isprime(17)));
print("isprime(10):" + str(isprime(10)));
print("isprime(2):" + str(isprime(2)));
print("isprime(1):" + str(isprime(1)));

// Test nextprime
var next_p1 = nextprime(10);
var next_p2 = nextprime(20);
print("nextprime(10):" + str(next_p1));
print("nextprime(20):" + str(next_p2));

