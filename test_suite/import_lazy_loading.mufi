// Test that modules are loaded lazily
// This test verifies that only imported modules are loaded

// First, use a function that should always be available (IO functions)
println("Testing lazy loading...");

// Import math and use it
import math;
var result = sqrt(25);
print("sqrt(25) = ");
println(result);

// Collections should NOT be loaded yet
// This would fail if collections were auto-loaded
// (We can't directly test this without inspection, but the behavior should be correct)

println("Test completed successfully!");
